docker-compose-production.yml

frontend:
  build:
    context: ./frontend
    args:
      VITE_API_URL: https://api.yourdomain.com



 healthcheck:
      test: ["CMD-SHELL", "pg_isready -q -d ${POSTGRES_DB} -U ${POSTGRES_USER}"]
      interval: 1m30s
      timeout: 30s
      retries: 10
      start_period: 30s
